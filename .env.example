# ─── Copy this file to .env and fill in your keys. NEVER commit .env ───

# Server
PORT=3000
# Comma-separated list of website origins allowed to embed the widget ("*" = any; lock this down in production)
ALLOWED_ORIGINS=*

# Branding (used in the system prompt, greeting and widget header)
ORG_NAME=Xplore Hospital
ASSISTANT_NAME=Priya
SUPPORT_PHONE=+91 44 4000 1234
EMERGENCY_PHONE=+91 44 4000 1108

# ─── LLM (Claude) ───
# Without a key the agent still works in "extractive" mode: it reads the best-matching
# passage from your website content verbatim (zero hallucination, less conversational).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies. Raise to medium if answers need more reasoning.
CLAUDE_EFFORT=low

# ─── Voice (Fish Audio) ───
FISH_API_KEY=
# TTS model header: s1 | speech-1.6 | speech-1.5
FISH_TTS_MODEL=s1
# Voice model IDs from https://fish.audio (pick a warm, friendly receptionist voice).
# Leave empty to use Fish Audio's default voice.
FISH_VOICE_ID_EN=
FISH_VOICE_ID_TA=

# ─── Knowledge base ───
# Optional: protects POST /api/admin/reindex
ADMIN_TOKEN=
